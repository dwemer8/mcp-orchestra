# Config template for the local-llm MCP server. Copy to .env and fill in LOCAL_API_KEY.
# .env is gitignored (holds the secret); this template is committed.

# Open WebUI/OpenAI-compatible API root. For this gateway, chat is under /api/chat/completions.
LOCAL_BASE_URL=https://your-gateway-host/api

# Model list path relative to LOCAL_BASE_URL. Open WebUI uses /models.
LOCAL_MODELS_PATH=/models

# Chat completions path relative to LOCAL_BASE_URL. Open WebUI uses /chat/completions.
LOCAL_CHAT_COMPLETIONS_PATH=/chat/completions

# Bearer token for the gateway. REQUIRED — the endpoint returns HTTP 401 without it.
LOCAL_API_KEY=

# Maximum parallel chat completion requests for local_batch.
LOCAL_MAX_CONCURRENCY=8

# Per-request timeout in seconds for model discovery and chat completions.
LOCAL_TIMEOUT_SECONDS=120
